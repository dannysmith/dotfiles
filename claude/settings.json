    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh release:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api:*)",
      "Bash(npm publish:*)",
      "Bash(bun publish:*)",
      "Bash(cargo publish:*)",
      "Bash(gh gist create)",
      "Bash(gh gist create:*)",
      "Bash(gh auth token)",
      "Bash(gh auth token:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(launchctl:*)",
      "Bash(dscl:*)",
      "Bash(defaults write:*)",
      "Bash(defaults delete:*)",
      "Bash(security:*)",
      "Bash(osascript:*)"
