  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "tdn@tdn-marketplace": true,
    "personal@dannysmith": true,
    "css-expert@dannysmith": true,
    "frontend-design@claude-plugins-official": true,
    "writing@dannysmith": true,
    "obsidian@obsidian-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "pypi.org",
        "files.pythonhosted.org",
        "esm.sh",
        "danny.is",
        "*.danny.is",
        "localhost",
        "127.0.0.1"
      ],
      "strictAllowlist": false,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches",
        "~/Library/pnpm",
        "~/.bun/install/cache",
        "~/Library/Developer",
        "~/Library/Logs/CoreSimulator",
        "/var/folders",
        "/private/var/folders",
        "~/.Trash"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.zshrc",
        "~/.zshenv",
        "~/.zprofile",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.claude",
        "~/Library/Caches/Google",
        "~/Library/Caches/com.apple.Safari",
        "~/Library/Caches/Firefox",
        "~/Library/Caches/Mozilla"
      ],
      "denyRead": [
        "~/Documents",
        "~/Desktop",
        "~/Downloads",
        "~/Pictures",
        "~/Music",
        "~/Movies",
        "~/notes",
        "~/Library",
        "~/Library/Caches/Google",
        "~/Library/Caches/com.apple.Safari",
        "~/Library/Caches/Firefox",
        "~/Library/Caches/Mozilla",
        "~/.zsh_history",
        "~/.zsh_sessions",
        "~/.bash_history",
        "~/.python_history",
        "~/.node_repl_history",
        "~/.irb_history",
        "~/.lesshst",
        "~/.viminfo",
        "/Volumes"
      ],
      "allowRead": [
        "~/Library/Caches",
        "~/Library/pnpm",
        "~/Library/Developer",
        "~/Library/Logs",
        "~/Library/Application Support/fnm",
        "~/.Trash"
      ],
      "disabled": false
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.cargo/credentials.toml",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.github_token",
          "mode": "deny"
        },
        {
          "path": "~/.docker",
          "mode": "deny"
        },
        {
          "path": "~/.tauri",
          "mode": "deny"
        },
        {
          "path": "~/.t3",
          "mode": "deny"
        },
        {
          "path": "~/.codex",
          "mode": "deny"
        },
        {
          "path": "~/.gemini",
          "mode": "deny"
        },
        {
          "path": "~/.mcp-auth",
          "mode": "deny"
        },
        {
          "path": "~/.config/1Password",
          "mode": "deny"
        },
        {
          "path": "~/.claude.json",
          "mode": "deny"
        },
        {
          "path": "~/.claude.json.backup",
          "mode": "deny"
        },
        {
          "path": "~/.orbstack/ssh",
          "mode": "deny"
        },
        {
          "path": "~/.n8n",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GEMINI_API_KEY",
          "mode": "deny"
        }
      ]
    },
    "allowAppleEvents": false,
    "excludedCommands": [
      "docker *",
      "gh *",
      "tdn *",
      "git push",
      "git push *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "ps",
      "ps *",
      "pgrep *",
      "lsof *",
      "kill *",
      "pkill *",
      "killall *",
      "defuddle",
      "defuddle *"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: none — personal machine, solo developer (Danny Smith). Primary use: software development across many small personal projects under ~/dev, plus non-coding work (personal knowledge management, writing, research).",
      "Source control: GitHub. github.com/dannysmith plus the orgs RootpathHQ, redacademy, adaapp and butterbakerylondon. Projects live one-repo-per-directory under ~/dev; reading and working across sibling repos there is routine.",
      "Repository visibility: mixed, repo by repo, and stated in each repo's own CLAUDE.md. Treat a repo as private unless its CLAUDE.md or the session says otherwise.",
      "Cloud provider(s): Vercel for static and Astro sites; a single Hetzner VPS running Docker services behind a shared Caddy reverse proxy. No AWS, GCP or Azure.",
      "Sensitive remote targets: the Hetzner VPS serving *.danny.is. SSH into it, docker or compose commands against it, and Caddy config changes are production operations. Vercel production deploys are production.",
      "Protected deployment namespaces / environments: anything serving a live *.danny.is or *.dny.li hostname.",
      "CI/CD deploy targets: GitHub Actions and Vercel.",
      "Secrets management: 1Password. No cloud secret manager; secrets are never committed.",
      "Internal package registry: none. Public registries (npm, crates.io, PyPI, esm.sh) are the expected and correct destination for installs. bun is the default package manager.",
      "Org-specific CLIs: `tdn` (personal task and notes CLI that reads and writes the Obsidian vault at ~/notes), `defuddle` (web page to markdown).",
      "Trusted internal domains: localhost and 127.0.0.1 for local dev servers; danny.is and *.danny.is.",
      "Internal sharing / snippet hosting: none. Public paste and gist services are outside the trust boundary.",
      "Sensitive data locations & audiences: ~/notes is a personal Obsidian vault (personal notes, journals, task data, client material); ~/Documents, ~/Desktop and ~/Downloads hold personal files. The cleared audience is the local session only — reading, editing and reorganising files in place is the routine expected work of vault sessions and is not exfiltration. Their contents must not leave them: never commit vault or personal-directory content to a git repo, put it in PR, issue or commit text, paste it to a gist or paste service, or send it to a third-party API.",
      "Network posture: every Bash command runs in Claude Code's Seatbelt sandbox with a deny-by-default network allowlist. Credential dot-folders (SSH, GPG, gh, npm, 1Password, other AI agents' config) are unreadable to both sandboxed commands and the Read tool.",
      "Additional context: solo developer, no compliance regime, no multi-tenant infrastructure, no regulated data. The risks that matter are irreversible loss of local work, and personal or client material leaking into a public repo."
    ]
  }
}
