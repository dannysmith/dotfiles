      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(ps)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(lsof:*)",
      "Bash(diskutil list)",
      "Bash(diskutil list:*)",
      "Bash(diskutil info:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh status)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(base64:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Skill(tdn@tdn-marketplace:*)",
      "Skill(tdn-claude-plugin:task-management)",
      "Skill(css-expert)",
      "Bash(tree:*)",
      "Bash(cargo check:*)",
      "Bash(pnpm run check:*)",
      "Bash(bun run check:*)",
      "Bash(npm run check:*)",
      "Bash(tdn context:*)",
      "Bash(tdn list:*)",
      "Bash(tdn show:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(reboot)",
      "Bash(shutdown:*)",
      "Bash(halt)",
      "Bash(poweroff)",
      "Bash(useradd:*)",
      "Bash(userdel:*)",
      "Bash(usermod:*)",
      "Bash(passwd:*)",
      "Bash(chpasswd:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(crontab:*)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partition*)",
      "Bash(diskutil reformat*)",
      "Bash(diskutil secureErase*)",
      "Bash(diskutil zeroDisk*)",
      "Bash(diskutil apfs delete*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.zsh_history)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.github_token)",
      "Read(~/.docker/**)",
      "Read(~/.tauri/**)",
      "Read(~/.t3/**)",
      "Read(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Read(~/.mcp-auth/**)",
      "Read(~/.config/1Password/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.orbstack/ssh/**)",
      "Read(~/.n8n/**)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/.node_repl_history)",
      "Read(~/.irb_history)",
      "Read(~/.lesshst)",
      "Read(~/.viminfo)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/.credentials.json)"
