{
  "cleanupPeriodDays": 60,
  "env": {
    "ASTRO_TELEMETRY_DISABLED": "1",
    "HOMEBREW_NO_ANALYTICS": "1"
  },
  "attribution": {
    "commit": "Most likely with oversight by an actual human, Danny.\n\nCo-Authored-By: Claude <noreply@anthropic.com>"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "MCP(context7:*)",
      "LS(*)",
      "Bash(ls:*)",
      "Bash(ll:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
