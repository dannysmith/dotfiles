      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(whoami)",
      "Bash(date)",
      "Bash(uname:*)",
      "Bash(printenv:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(type:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git show:*)",
